# Copy this file to .env and set values for your environment.
# Defaults run fully locally: deterministic hashing embeddings, an extractive answerer,
# and a JSON vector index. No source code or API key leaves this machine by default.

REPOSAGE_CORS_ORIGINS=http://localhost:3000
REPOSAGE_MAX_FILE_SIZE_BYTES=750000
REPOSAGE_MAX_REPOSITORY_FILES=3000
REPOSAGE_CHUNK_SIZE=1200
REPOSAGE_CHUNK_OVERLAP=160
REPOSAGE_INDEX_WORKERS=2
# Optional single-instance safeguards. Leave blank/zero for local development.
REPOSAGE_API_KEY=
REPOSAGE_RATE_LIMIT_REQUESTS_PER_MINUTE=0
REPOSAGE_EMBEDDING_DIMENSIONS=256
REPOSAGE_PROVIDER_TIMEOUT_SECONDS=60

# LLM: extractive (default), openai, gemini, or ollama.
# Set the model appropriate for the selected provider.
REPOSAGE_LLM_PROVIDER=extractive
REPOSAGE_LLM_MODEL=gpt-4o-mini
REPOSAGE_LLM_TEMPERATURE=0.1
REPOSAGE_OPENAI_API_KEY=
REPOSAGE_OPENAI_BASE_URL=https://api.openai.com/v1
REPOSAGE_GEMINI_API_KEY=
REPOSAGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REPOSAGE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embeddings: hashing (default), openai, gemini, bge, or nomic.
# BGE runs locally and downloads its model on first use.
REPOSAGE_EMBEDDING_PROVIDER=hashing
REPOSAGE_EMBEDDING_MODEL=text-embedding-3-small
REPOSAGE_BGE_MODEL=BAAI/bge-small-en-v1.5
REPOSAGE_NOMIC_API_KEY=
REPOSAGE_NOMIC_BASE_URL=https://api-atlas.nomic.ai/v1

# Vector store: local (default), qdrant, chroma, or faiss.
# Qdrant may point to a self-hosted service or Qdrant Cloud endpoint.
REPOSAGE_VECTOR_STORE_PROVIDER=local
REPOSAGE_QDRANT_URL=http://qdrant:6333
REPOSAGE_QDRANT_API_KEY=
REPOSAGE_QDRANT_COLLECTION_PREFIX=reposage
# Optional persistence locations; defaults are under REPOSAGE_DATA_DIR.
# REPOSAGE_CHROMA_PATH=/data/chroma
# REPOSAGE_FAISS_PATH=/data/faiss

# Browser-visible API origin. For Docker Compose, this remains localhost because
# requests originate in your browser, not from inside the frontend container.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Only set for a trusted/private browser deployment; it is embedded in the frontend build.
NEXT_PUBLIC_REPOSAGE_API_KEY=
