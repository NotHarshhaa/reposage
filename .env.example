# Copy this file to .env and set values for your environment.
# The default implementation uses local deterministic embeddings and an extractive,
# citation-grounded answerer, so no API key is required to run the MVP.

REPOSAGE_CORS_ORIGINS=http://localhost:3000
REPOSAGE_MAX_FILE_SIZE_BYTES=750000
REPOSAGE_MAX_REPOSITORY_FILES=3000
REPOSAGE_CHUNK_SIZE=1200
REPOSAGE_CHUNK_OVERLAP=160
REPOSAGE_EMBEDDING_DIMENSIONS=256

# Browser-visible API origin. For Docker Compose, this remains localhost because
# requests originate in your browser, not from inside the frontend container.
NEXT_PUBLIC_API_URL=http://localhost:8000
